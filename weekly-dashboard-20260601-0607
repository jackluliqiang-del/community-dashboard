function svgLine(el, series){const w=760,h=310,p=44; const data=DATA.summary; const vals=series.flatMap(s=>data.map(d=>Number(d[s.key]||0))); const max=Math.max(...vals)*1.12||1,min=0; const X=i=>p+i*(w-2*p)/(data.length-1); const Y=v=>h-p-(v-min)/(max-min)*(h-2*p); let grid=''; for(let i=0;i<5;i++){let y=p+i*(h-2*p)/4;grid+=`<line class="gridline" x1="${p}" y1="${y}" x2="${w-p}" y2="${y}"/>`;} let lines=series.map(s=>{let pts=data.map((d,i)=>`${X(i).toFixed(1)},${Y(Number(d[s.key]||0)).toFixed(1)}`).join(' '); let dots=data.map((d,i)=>`<circle cx="${X(i)}" cy="${Y(Number(d[s.key]||0))}" r="4" fill="#fff" stroke="${s.color}" stroke-width="3"><title>${d.week} ${s.name}：${Number(d[s.key]||0).toLocaleString('zh-CN',{maximumFractionDigits:1})}</title></circle>`).join(''); return `<polyline points="${pts}" fill="none" stroke="${s.color}" stroke-width="4" stroke-linecap="round"/>${dots}`;}).join(''); let axis=data.map((d,i)=>`<text x="${X(i)}" y="${h-12}" text-anchor="middle">${d.week.slice(0,5)}</text>`).join(''); document.getElementById(el).innerHTML=`<svg class="chart" viewBox="0 0 ${w} ${h}">${grid}${lines}<g class="axis">${axis}</g></svg>`;}
svgLine('salesChart',[{key:'群引导有效金额',name:'数云销售额',color:'#2563eb'},{key:'yzSales',name:'有赞销售额',color:'#0d9488'},{key:'群引导付款客户',name:'付款客户',color:'#059669'}]); svgLine('activeChart',[{key:'群内发送消息客户数',name:'群活跃人数',color:'#059669'},{key:'群内客户发送消息总数',name:'用户消息量',color:'#d97706'},{key:'教练发送消息数',name:'教练消息量',color:'#7c3aed'}]);
function coachChart(){const rows=DATA.coachData; const max=Math.max(...rows.flatMap(r=>[r.sySales||0,r.yzSales||0])); document.getElementById('coachChart').innerHTML=`<div class="table-wrap" style="max-height:none"><table style="min-width:900px"><thead><tr><th>教练</th><th>数云销售额</th><th>有赞销售额</th><th>工作量分</th><th>销售可视化</th></tr></thead><tbody>${rows.map(r=>`<tr><td><b>${r.name}</b></td><td>${money(r.sySales)} <span class="${cls(r.syPct)}">(${pct(r.syPct)})</span></td><td>${money(r.yzSales)} <span class="${cls(r.yzPct)}">(${pct(r.yzPct)})</span></td><td>${Number(r.workload||0).toFixed(1)}</td><td>数云<div class="bar-mini"><i style="width:${Math.max(2,(r.sySales||0)/max*100)}%"></i></div> 有赞<div class="bar-mini"><i style="width:${Math.max(2,(r.yzSales||0)/max*100)}%;background:var(--teal)"></i></div></td></tr>`).join('')}</tbody></table></div>`; document.getElementById('coachRows').innerHTML=rows.map(r=>`<tr><td><b>${r.name}</b></td><td>${num(r.groups)}</td><td>${num(r.members)}</td><td>${Number(r.workload||0).toFixed(1)}</td><td><span class="badge">${r.status}</span></td><td>${yuan(r.yzSales)}</td><td><span class="${cls(r.yzPct)}">${pct(r.yzPct)}</span></td><td>${yuan(r.sySales)}</td><td><span class="${cls(r.syPct)}">${pct(r.syPct)}</span></td><td>${r.qc==null?'—':r.qc}</td><td>${num(r.special)}</td></tr>`).join('');} coachChart();
function topCards(id, rows){document.getElementById(id).innerHTML=rows.map((g,i)=>`<div class="top-card"><span class="rank">TOP ${i+1}</span><span class="score">${Number(g.score||0).toFixed(1)}</span><h3 style="margin-top:12px;min-height:44px;line-height:1.4">${shortName(g.name)}</h3><p class="muted" style="font-size:13px">${g.coach}｜${g.abc}类｜${g.shortfall||'—'}</p><div class="metric"><p>数云：<b>${yuan(g.sySales)}</b></p><p>销售环比：<span class="${cls(g.sySalesPct)}">${pct(g.sySalesPct)}</span></p><p>活跃：${num(g.active)} / <span class="${cls(g.activeDelta)}">${diff(g.activeDelta)}</span></p><p>用户消息：${num(g.userMsg)} / <span class="${cls(g.userMsgDelta)}">${diff(g.userMsgDelta)}</span></p></div><p class="muted" style="font-size:12px;line-height:1.6;margin-top:8px">${g.reason}</p></div>`).join('')} topCards('topComposite', DATA.top5Composite); topCards('topSales', DATA.top5Sales);
const coachFilter=document.getElementById('coachFilter'); ['全部',...Array.from(new Set(DATA.groupCompare.map(g=>g.coach).filter(Boolean)))].forEach(c=>coachFilter.innerHTML+=`<option value="${c}">${c}</option>`); ['search','coachFilter','abcFilter','sortFilter'].forEach(id=>document.getElementById(id).addEventListener(id==='search'?'input':'change', renderRows)); function renderRows(){const q=document.getElementById('search').value.trim(), coach=coachFilter.value, abc=document.getElementById('abcFilter').value, sort=document.getElementById('sortFilter').value; const maxSales=Math.max(...DATA.groupCompare.map(g=>g.sySales||0)); let rows=DATA.groupCompare.filter(g=>(coach==='全部'||g.coach===coach)&&(abc==='全部'||g.abc===abc)&&(!q||`${g.name} ${g.coach} ${g.shortfall} ${g.reason}`.includes(q))).sort((a,b)=>(b[sort]||0)-(a[sort]||0)); document.getElementById('groupRows').innerHTML=rows.map(g=>`<tr><td><b>${g.name}</b></td><td>${g.coach}</td><td><span class="badge ${g.abc==='A'?'badgeA':g.abc==='C'?'badgeC':''}">${g.abc||'—'}</span></td><td>${g.shortfall||'—'}</td><td>${num(g.active)}</td><td><span class="${cls(g.activeDelta)}">${diff(g.activeDelta)}</span> / <span class="${cls(g.activePct)}">${pct(g.activePct)}</span></td><td>${num(g.userMsg)}</td><td><span class="${cls(g.userMsgDelta)}">${diff(g.userMsgDelta)}</span> / <span class="${cls(g.userMsgPct)}">${pct(g.userMsgPct)}</span></td><td>${yuan(g.sySales)}<span class="bar-mini"><i style="width:${Math.max(2,(g.sySales||0)/maxSales*100)}%"></i></span></td><td><span class="${cls(g.sySalesPct)}">${pct(g.sySalesPct)}</span></td><td>${num(g.coachMsg)} / <span class="${cls(g.coachMsgDelta)}">${diff(g.coachMsgDelta)}</span></td><td>${Number(g.score||0).toFixed(1)}</td></tr>`).join(''); document.getElementById('rowCount').textContent=`当前筛选后显示 ${rows.length} 个群，共 ${DATA.groupCompare.length} 个群。`;} renderRows();
function bars(id,obj){const vals=Object.entries(obj); const max=Math.max(...vals.map(x=>x[1]),1); document.getElementById(id).innerHTML=vals.map(([k,v])=>`<div style="display:grid;grid-template-columns:90px 1fr 36px;gap:10px;align-items:center;margin:12px 0;font-size:14px"><span>${k}</span><div style="height:12px;background:#e2e8f0;border-radius:999px;overflow:hidden"><i style="display:block;height:100%;width:${v/max*100}%;background:var(--blue);border-radius:999px"></i></div><b>${v}</b></div>`).join('')} bars('abcBars', DATA.abcCounts); bars('shortBars', DATA.shortCounts); document.getElementById('bottom5').innerHTML=DATA.bottom5.map((g,i)=>`<div style="padding:11px 0;border-bottom:1px solid #e2e8f0"><b>${i+1}. ${shortName(g.name)}</b><p class="muted" style="font-size:13px;line-height:1.6">${g.coach}｜${g.abc}类｜${g.shortfall}｜综合分 ${Number(g.score||0).toFixed(1)}｜数云 ${yuan(g.sySales)}</p></div>`).join('');
</script></body></html>
